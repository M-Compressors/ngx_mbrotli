#!/bin/sh
# nginx-mod-mbrotli: /usr/share/nginx/modules/mod-mbrotli.conf, which nginx.conf
# includes, loads the module. As the distribution's nginx-mod-* packages do,
# reload nginx on the first installation.
if [ "$1" -eq 1 ]; then
    /usr/bin/systemctl reload nginx.service >/dev/null 2>&1 || :
fi
